@model DiyetisyenApp.Models.ViewModels.SingleExchangeRequest
@using DiyetisyenApp.Models.ViewModels

@{
    ViewData["Title"] = "Tek Değişim Hesaplama";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --primary: #4f46e5;
        --secondary: #64748b;
        --card-bg: #ffffff;
        --input-bg: #f8fafc;
    }

    body {
        font-family: 'Inter', sans-serif;
        background-color: #f1f5f9;
        color: #1e293b;
    }

    .calc-container {
        max-width: 900px;
        margin: 50px auto;
        padding: 0 20px;
    }

    .main-card {
        background: var(--card-bg);
        border-radius: 20px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.05);
        overflow: hidden;
        border: 1px solid rgba(226, 232, 240, 0.8);
    }

    .card-header {
        background: white;
        padding: 25px;
        border-bottom: 1px solid #f1f5f9;
        text-align: center;
    }

    .card-header h2 {
        font-weight: 700;
        margin: 0;
        color: var(--primary);
        font-size: 1.5rem;
    }

    .input-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        padding: 30px;
    }

    .input-group-custom {
        display: flex;
        flex-direction: column;
    }

    .input-group-custom label {
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 8px;
        color: var(--secondary);
    }

    .input-group-custom input {
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        padding: 12px;
        transition: all 0.2s;
        background: var(--input-bg);
        font-weight: 600;
    }

    .input-group-custom input:focus {
        outline: none;
        border-color: var(--primary);
        background: white;
        box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
    }

    .btn-submit {
        background: var(--primary);
        color: white;
        border: none;
        padding: 15px 30px;
        border-radius: 12px;
        font-weight: 700;
        width: 100%;
        transition: all 0.3s;
        cursor: pointer;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
    }

    .btn-submit:hover {
        background: #4338ca;
        transform: translateY(-2px);
    }

    .result-section {
        background: #f8fafc;
        padding: 30px;
        border-top: 2px dashed #e2e8f0;
    }

    .stats-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 15px;
        margin-top: 20px;
    }

    .stat-card {
        background: white;
        padding: 20px;
        border-radius: 15px;
        text-align: center;
        border: 1px solid #e2e8f0;
    }

    .stat-card.energy { border-left: 5px solid #ef4444; }
    .stat-card.cho { border-left: 5px solid #f59e0b; }
    .stat-card.pro { border-left: 5px solid #10b981; }
    .stat-card.fat { border-left: 5px solid #3b82f6; }

    .stat-value { font-size: 1.25rem; font-weight: 700; display: block; }
    .stat-label { font-size: 0.75rem; color: var(--secondary); text-transform: uppercase; font-weight: 600; }
    .stat-percent { font-size: 0.85rem; color: var(--primary); font-weight: 600; }
</style>

<div class="calc-container">
    <div class="main-card">
        <div class="card-header">
            <h2><i class="bi bi-lightning-charge-fill me-2"></i>Hızlı Değişim Hesaplayıcı</h2>
        </div>

        <form method="post">
            <div class="input-grid">

                <div class="input-group-custom">
                    <label><i class="bi bi-cup-hot me-1"></i> Süt Değişimi</label>
                    <input asp-for="Milk" type="number" step="1" min="0" onkeydown="return event.key !== '.' && event.key !== '-'" class="form-control" placeholder="0" />
                </div>

                <div class="input-group-custom">
                    <label><i class="bi bi-egg-fill me-1"></i> Et Değişimi</label>
                    <input asp-for="Meat"type="number" step="1" min="0" onkeydown="return event.key !== '.' && event.key !== '-'" class="form-control" placeholder="0" />
                </div>

                <div class="input-group-custom">
                    <label><i class="bi bi-bread-slice me-1"></i> EYG Değişimi</label>
                    <input asp-for="Eyg" type="number" step="1" min="0" onkeydown="return event.key !== '.' && event.key !== '-'" class="form-control" placeholder="0"/>
                </div>

                <div class="input-group-custom">
                    <label><i class="bi bi-tree-fill me-1"></i> Sebze Değişimi</label>
                    <input asp-for="Vegetable" type="number" step="1" min="0" onkeydown="return event.key !== '.' && event.key !== '-'" class="form-control" placeholder="0" />
                </div>

                <div class="input-group-custom">
                    <label><i class="bi bi-apple me-1"></i> Meyve Değişimi</label>
                    <input asp-for="Fruit" type="number" step="1" min="0" onkeydown="return event.key !== '.' && event.key !== '-'" class="form-control" placeholder="0" />
                </div>

                <div class="input-group-custom">
                    <label><i class="bi bi-droplet-fill me-1"></i> Yağ Değişimi</label>
                    <input asp-for="Fat" type="number" step="1" min="0" onkeydown="return event.key !== '.' && event.key !== '-'" class="form-control" placeholder="0" />
                </div>

                <div class="input-group-custom">
                    <label><i class="bi bi-flower1 me-1"></i> Yağlı Tohum Değişimi</label>
                    <input asp-for="OilySeed" type="number" step="1" min="0" onkeydown="return event.key !== '.' && event.key !== '-'" class="form-control" placeholder="0" />
                </div>

            </div>

            <div class="px-5 pb-5">
                <button type="submit" class="btn-submit">
                    <i class="bi bi-calculator"></i> HESAPLA
                </button>
            </div>
        </form>

        @if (ViewBag.Result != null)
        {
            var r = (NutritionSummary)ViewBag.Result;

            <div class="result-section">
                <h4 class="text-center fw-bold mb-4">Besin Değerleri Analizi</h4>
                
                <div class="stats-row">
                    <div class="stat-card energy">
                        <span class="stat-label">Enerji</span>
                        <span class="stat-value text-danger">@r.Calories <small>kcal</small></span>
                    </div>

                    <div class="stat-card cho">
                        <span class="stat-label">Karbonhidrat (CHO)</span>
                        <span class="stat-value">@r.Carbs <small>g</small></span>
                        <span class="stat-percent">%@r.CarbsPercent.ToString("0")</span>
                    </div>

                    <div class="stat-card pro">
                        <span class="stat-label">Protein</span>
                        <span class="stat-value">@r.Protein <small>g</small></span>
                        <span class="stat-percent">%@r.ProteinPercent.ToString("0")</span>
                    </div>

                    <div class="stat-card fat">
                        <span class="stat-label">Yağ</span>
                        <span class="stat-value">@r.Fat <small>g</small></span>
                        <span class="stat-percent">%@r.FatPercent.ToString("0")</span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>