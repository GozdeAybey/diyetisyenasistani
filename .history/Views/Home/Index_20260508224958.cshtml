<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --primary-color: #6366f1;
        --secondary-color: #4f46e5;
        --accent-color: #10b981;
        --text-dark: #1e293b;
        --text-light: #64748b;
        --bg-gradient: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
    }

    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background: var(--bg-gradient);
        color: var(--text-dark);
        min-height: 100vh;
        overflow-x: hidden;
    }

    /* Arka Plan */
    .blob-1 {
        position: absolute;
        width: 600px;
        height: 600px;
        background: radial-gradient(circle, rgba(99, 102, 241, 0.15) 0%, rgba(255,255,255,0) 70%);
        top: -200px;
        right: -100px;
        z-index: -1;
        animation: float 20s infinite alternate;
    }

    @@keyframes float {
        0% { transform: translate(0, 0); }
        100% { transform: translate(-50px, 50px); }
    }

    /* HERO */
    .hero-section {
        padding: 70px 0 30px;
        position: relative;
    }

    .badge-premium {
        background: white;
        padding: 10px 20px;
        border-radius: 100px;
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--primary-color);
        box-shadow: 0 10px 20px rgba(0,0,0,0.05);
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 25px;
        border: 1px solid rgba(99, 102, 241, 0.1);
    }

    .hero-title {
        font-size: 3.5rem;
        font-weight: 800;
        line-height: 1.1;
        letter-spacing: -2px;
        margin-bottom: 25px;
    }

    .hero-title span {
        background: linear-gradient(to right, var(--primary-color), var(--accent-color));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    /* Görsel */
    .img-container {
        position: relative;
        perspective: 1000px;
    }

    .main-img {
        border-radius: 30px;
        box-shadow: 0 30px 60px rgba(0,0,0,0.12);
        transform: rotateY(-5deg) rotateX(5deg);
        transition: 0.5s;
        width: 100%;
    }

    .img-container:hover .main-img {
        transform: rotateY(0) rotateX(0);
    }

    /* Kartlar */
    .cards-wrapper {
        margin-top: -20px;
        position: relative;
        z-index: 10;
    }

    .feature-card {
        background: rgba(255, 255, 255, 0.82);
        backdrop-filter: blur(14px);
        border: 1px solid rgba(255, 255, 255, 0.5);
        border-radius: 32px;
        padding: 36px;
        text-align: center;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        height: 100%;
        min-height: 410px;

        display: flex;
        flex-direction: column;
        justify-content: space-between;

        box-shadow: 0 15px 40px rgba(0,0,0,0.06);
    }

    .feature-card:hover {
        transform: translateY(-12px);
        background: #fff;
        box-shadow: 0 35px 80px rgba(99, 102, 241, 0.18);
    }

    .icon-wrapper {
        width: 80px;
        height: 80px;
        margin: 0 auto 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 24px;
        font-size: 2rem;
        transition: 0.3s;
    }

    .c-1 { background: #eef2ff; color: #6366f1; }
    .c-2 { background: #ecfdf5; color: #10b981; }
    .c-3 { background: #fff7ed; color: #f59e0b; }

    .feature-card:hover .icon-wrapper {
        transform: scale(1.1) rotate(5deg);
    }

    .feature-card h4 {
        font-weight: 800;
        margin-bottom: 15px;
    }

    .feature-card p {
        color: var(--text-light);
        line-height: 1.7;
        margin-bottom: 25px;
    }

    .btn-action {
        background: var(--text-dark);
        color: white;
        border: none;
        padding: 14px 25px;
        border-radius: 16px;
        font-weight: 700;
        width: 100%;
        transition: 0.3s;
        margin-top: 20px;
        display: inline-block;
        text-decoration: none;
    }

    .btn-action:hover {
        background: var(--primary-color);
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 12px 24px rgba(99, 102, 241, 0.3);
    }

    .stats-label {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 700;
        color: var(--text-light);
        margin-top: 10px;
    }

    /* Responsive */
    @@media (max-width: 992px) {
        .hero-section {
            padding: 50px 0 20px;
            text-align: center;
        }

        .hero-title {
            font-size: 2.8rem;
        }

        .cards-wrapper {
            margin-top: 20px;
        }

        .main-img {
            margin-top: 20px;
        }
    }

    @@media (max-width: 768px) {
        .hero-title {
            font-size: 2.3rem;
        }

        .feature-card {
            min-height: auto;
        }
    }
</style>

<div class="blob-1"></div>

<!-- HERO -->
<section class="container hero-section">
    <div class="row align-items-center gy-5">
        
        <div class="col-lg-6">
            <div class="badge-premium">
                <i class="bi bi-shield-check-fill"></i>
                Profesyonel Diyetisyen Asistanı
            </div>

            <h1 class="hero-title">
                Beslenmeyi <span>Akıllı</span> Verilerle Yönetin
            </h1>

            <p class="lead text-muted mb-4 fs-5">
                Vakit alan manuel hesaplamaları geride bırakın.
                Bilimsel formüllerle desteklenen modern beslenme analiz paneli ile
                hızlı, güvenilir ve profesyonel sonuçlar elde edin.
            </p>

            <div class="d-flex flex-wrap gap-4 mt-4">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill text-success"></i>
                    <span class="fw-bold">Hızlı Rapor</span>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill text-success"></i>
                    <span class="fw-bold">Hassas Ölçüm</span>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill text-success"></i>
                    <span class="fw-bold">Bilimsel Hesaplama</span>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="img-container">
                <img src="https://images.unsplash.com/photo-1490645935967-10de6ba17061?auto=format&fit=crop&q=80&w=800"
                     class="img-fluid main-img"
                     alt="Nutrition Hub">
            </div>
        </div>

    </div>
</section>

<!-- KARTLAR -->
<section class="container pb-5 cards-wrapper">
    <div class="row g-4">

        <div class="col-lg-4 col-md-6">
            <div class="feature-card">

                <div>
                    <div class="icon-wrapper c-1">
                        <i class="bi bi-calculator"></i>
                    </div>

                    <h4>Kalori Aralığı</h4>

                    <p>
                        Bireye özel minimum ve maksimum enerji gereksinimlerini
                        otomatik analiz ederek hızlı sonuçlar üretin.
                    </p>
                </div>

                <div>
                    <div class="stats-label">
                        Hızlı Makro Dağılımı
                    </div>

                    <a asp-controller="Calculation"
                       asp-action="Index"
                       class="btn btn-action">
                        Hemen Başla
                        <i class="bi bi-arrow-right ms-2"></i>
                    </a>
                </div>

            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="feature-card">

                <div>
                    <div class="icon-wrapper c-2">
                        <i class="bi bi-activity"></i>
                    </div>

                    <h4>BMH & BKI</h4>

                    <p>
                        Mifflin-St Jeor ve Harris-Benedict formülleri ile
                        profesyonel antropometrik değerlendirme yapın.
                    </p>
                </div>

                <div>
                    <div class="stats-label">
                        Antropometrik Analiz
                    </div>

                    <a asp-controller="Bmr"
                       asp-action="Index"
                       class="btn btn-action">
                        Hemen Başla
                        <i class="bi bi-arrow-right ms-2"></i>
                    </a>
                </div>

            </div>
        </div>

        <div class="col-lg-4 col-md-12">
            <div class="feature-card">

                <div>
                    <div class="icon-wrapper c-3">
                        <i class="bi bi-intersect"></i>
                    </div>

                    <h4>Değişim Sistemi</h4>

                    <p>
                        Besin gruplarını otomatik değişim listelerine dönüştürerek
                        pratik ve hızlı menü planlaması oluşturun.
                    </p>
                </div>

                <div>
                    <div class="stats-label">
                        Akıllı Liste Yönetimi
                    </div>

                    <a asp-controller="SingleExchange"
                       asp-action="Index"
                       class="btn btn-action">
                        Hemen Başla
                        <i class="bi bi-arrow-right ms-2"></i>
                    </a>
                </div>

            </div>
        </div>

    </div>
</section>