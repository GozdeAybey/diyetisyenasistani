@model DiyetisyenApp.Models.ViewModels.CalculationRequest
@using DiyetisyenApp.Models.ViewModels
@using DiyetisyenApp.Models.Domain

@{
    ViewData["Title"] = "Kalori & Değişim Hesaplama";
    var foodGroups = ViewBag.FoodGroups as List<FoodGroup>;
    var table = ViewBag.Table as List<MacroFocusRow>;
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --primary: #4f46e5;
        --success: #10b981;
        --kh-color: #f59e0b;
        --protein-color: #ef4444;
        --fat-color: #3b82f6;
        --bg-main: #f3f4f6;
    }

    body { font-family: 'Inter', sans-serif; background-color: var(--bg-main); color: #1f2937; }

    .page-container { max-width: 1200px; margin: 40px auto; padding: 0 20px; }
    
    .section-title { font-weight: 700; font-size: 1.75rem; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 10px; }
    .section-title i { color: var(--primary); }

    /* Kart Tasarımı */
    .glass-card {
        background: white;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
        border: 1px solid rgba(0,0,0,0.05);
        margin-bottom: 24px;
    }

    .card-header-custom { font-weight: 600; font-size: 1.1rem; margin-bottom: 20px; display: flex; align-items: center; border-bottom: 2px solid #f9fafb; padding-bottom: 10px; }

    /* Form Elemanları */
    .form-label { font-size: 0.85rem; font-weight: 600; color: #4b5563; margin-bottom: 6px; }
    .form-control-custom {
        width: 100%; padding: 10px 15px; border: 1.5px solid #e5e7eb; border-radius: 10px;
        transition: all 0.2s; font-size: 0.95rem;
    }
    .form-control-custom:focus { border-color: var(--primary); outline: none; box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1); }

    /* Değişim Grid */
    .exchange-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 15px; }
    .exchange-item { 
        background: #f9fafb; padding: 15px; border-radius: 12px; border: 1px solid #f1f5f9;
        transition: transform 0.2s;
    }
    .exchange-item:hover { transform: translateY(-2px); border-color: var(--primary); }

    /* Tablo ve Sonuçlar */
    .results-grid { display: grid; grid-template-columns: 1fr; gap: 24px; }
    .macro-card { overflow: hidden; }
    .table-custom { width: 100%; border-collapse: collapse; margin-top: 10px; }
    .table-custom th { background: #f8fafc; padding: 12px; font-size: 0.8rem; text-transform: uppercase; color: #64748b; border-bottom: 2px solid #edf2f7; }
    .table-custom td { padding: 14px 12px; font-size: 0.9rem; border-bottom: 1px solid #f1f5f9; text-align: center; }

    /* Makro Odak Renkleri */
    .macro-KH { border-top: 5px solid var(--kh-color); }
    .macro-Protein { border-top: 5px solid var(--protein-color); }
    .macro-Yag { border-top: 5px solid var(--fat-color); }

    .badge-macro { padding: 4px 8px; border-radius: 6px; font-weight: 600; font-size: 0.8rem; }
    .bg-kh { background: #fef3c7; color: #92400e; }
    .bg-pro { background: #fee2e2; color: #991b1b; }
    .bg-fat { background: #dbeafe; color: #1e40af; }

    .btn-calculate {
        background: var(--primary); color: white; border: none; padding: 12px 40px;
        border-radius: 12px; font-weight: 600; width: 100%; transition: all 0.3s;
    }
    .btn-calculate:hover { background: #4338ca; transform: translateY(-1px); box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3); }
</style>

<div class="page-container">
    <h2 class="section-title"><i class="bi bi-calculator"></i> Kalori & Değişim Hesaplama</h2>

    <form asp-controller="Calculation" asp-action="Index" method="post">
        <div class="row">
            <div class="col-md-4">
                <div class="glass-card h-100">
                    <div class="card-header-custom"><i class="bi bi-fire me-2 text-danger"></i> Hedef Kalori</div>
                    <div class="row">
                        <div class="col-6">
                            <label class="form-label">Minimum</label>
                            <input asp-for="MinCalories" class="form-control-custom" placeholder="Örn: 1800" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Maximum</label>
                            <input asp-for="MaxCalories" class="form-control-custom" placeholder="Örn: 2200" />
                        </div>
                    </div>
                    <div class="mt-4">
                        <p class="text-muted small">Lütfen hesaplamak istediğiniz ideal kalori aralığını giriniz.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-8">
                <div class="glass-card">
                    <div class="card-header-custom"><i class="bi bi-egg-fried me-2 text-success"></i> Besin Grubu Değişimleri</div>
                    @if (foodGroups != null)
                    {
                        <div class="exchange-grid">
                            @for (int i = 0; i < foodGroups.Count; i++)
                            {
                                <div class="exchange-item">
                                    <label class="form-label d-block mb-2">@foodGroups[i].Name</label>
                                    <input type="hidden" name="ExchangeRanges[@i].FoodGroupId" value="@foodGroups[i].Id" />
                                    <div class="d-flex gap-2">
                                       <input asp-for="ExchangeRanges[@i].Min"
                                            type="number"
                                            min="0"
                                            step="1"
                                            class="form-control-custom text-center"
                                            placeholder="Min" />

                                        <input asp-for="ExchangeRanges[@i].Max"
                                            type="number"
                                            min="0"
                                            step="1"
                                            class="form-control-custom text-center"
                                            placeholder="Max" />
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    <div class="mt-4">
                        <button type="submit" class="btn-calculate">
                            <i class="bi bi-cpu me-2"></i> Verileri Analiz Et ve Hesapla
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
    <div class="d-flex gap-2 mt-3">
        <form asp-action="Clear" method="post">
            <button type="submit" class="btn btn-outline-danger">
                Temizle
            </button>
        </form>
    </div>
    @if (table != null && table.Any())
    {
        <h2 class="section-title mt-5"><i class="bi bi-bar-chart-steps"></i> Analiz Sonuçları</h2>
        <div class="results-grid">
            @foreach (var macroGroup in table.GroupBy(x => x.FocusMacro))
            {
                var (mClass, mIcon, mBadge) = macroGroup.Key switch
                {
                    "KH" => ("macro-KH", "bi-tsunami", "bg-kh"),
                    "Protein" => ("macro-Protein", "bi-capsule", "bg-pro"),
                    "Yağ" => ("macro-Yag", "bi-droplet-fill", "bg-fat"),
                    _ => ("", "", "")
                };

                <div class="glass-card @mClass macro-card">
                    <div class="card-header-custom justify-content-between">
                        <span><i class="bi @mIcon me-2"></i> @macroGroup.Key Odaklı Alternatifler</span>
                        <span class="badge @mBadge">@macroGroup.Key Ağırlıklı</span>
                    </div>

                    <div class="table-responsive">
                        <table class="table-custom">
                            <thead>
                                <tr>
                                    <th>Seviye</th>
                                    <th><i class="bi bi-lightning-fill text-warning"></i> Kalori</th>
                                    <th>KH (g / %)</th>
                                    <th>Protein (g / %)</th>
                                    <th>Yağ (g / %)</th>
                                    <th>Değişimler</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in macroGroup)
                                {
                                    <tr>
                                        <td class="fw-bold text-secondary">S @r.Level</td>
                                        <td class="fw-bold">@r.TotalCalories kcal</td>
                                        <td>
                                            <span class="fw-medium">@r.Carbs g</span> 
                                            <small class="text-muted d-block">%@r.CarbsPercent.ToString("0.0")</small>
                                        </td>
                                        <td>
                                            <span class="fw-medium">@r.Protein g</span> 
                                            <small class="text-muted d-block">%@r.ProteinPercent.ToString("0.0")</small>
                                        </td>
                                        <td>
                                            <span class="fw-medium">@r.Fat g</span> 
                                            <small class="text-muted d-block">%@r.FatPercent.ToString("0.0")</small>
                                        </td>
                                        <td>
                                    @if (r.ExchangeCounts != null && r.ExchangeCounts.Any())
                                            {
                                                <div class="text-start small">
                                                    @foreach (var ex in r.ExchangeCounts)
                                                    {
                                                        <div>
                                                            <strong>@ex.Key:</strong> @ex.Value
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </td>
                                   </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    }
</div>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

@if (ViewBag.NoResult != null && ViewBag.NoResult == true)
{
    <script>
        Swal.fire({
            icon: 'warning',
            title: 'Sonuç Bulunamadı',
            text: 'Seçtiğiniz kalori aralığında uygun bir kombinasyon bulunamadı. Lütfen değişim aralığınızı kontrol edin.',
            confirmButtonText: 'Tamam',
            confirmButtonColor: '#4f46e5'
        });
    </script>
}