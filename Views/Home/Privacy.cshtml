@{
    ViewData["Title"] = "Gizlilik Politikası";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    body {
        font-family: 'Inter', sans-serif;
        background: #f3f4f6;
        color: #1f2937;
    }

    .privacy-container {
        max-width: 1000px;
        margin: 50px auto;
        padding: 20px;
    }

    .header-box {
        text-align: center;
        margin-bottom: 40px;
    }

    .header-box h1 {
        font-weight: 700;
        font-size: 2.2rem;
    }

    .header-box p {
        color: #6b7280;
    }

    .policy-card {
        background: white;
        border-radius: 16px;
        padding: 25px;
        margin-bottom: 20px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        border-left: 5px solid #4f46e5;
    }

    .policy-card h4 {
        font-weight: 600;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .policy-card p {
        font-size: 0.95rem;
        color: #374151;
    }

    .policy-card ul {
        padding-left: 18px;
    }

    .policy-card li {
        margin-bottom: 6px;
    }

    .highlight {
        background: #eef2ff;
        padding: 10px;
        border-radius: 8px;
        font-weight: 500;
    }
</style>

<div class="privacy-container">

    <div class="header-box">
        <h1><i class="bi bi-shield-lock"></i> Gizlilik Politikası</h1>
        <p>Son güncelleme: @DateTime.Now.ToString("dd.MM.yyyy")</p>
    </div>

    <div class="policy-card">
        <h4><i class="bi bi-info-circle"></i> Genel Bilgilendirme</h4>
        <p>
            Diyetisyen Asistanı, kullanıcı gizliliğini ön planda tutar. Bu politika,
            uygulamada işlenen verilerin kapsamını ve kullanım amacını açıklamaktadır.
        </p>
    </div>

    <div class="policy-card">
        <h4><i class="bi bi-person"></i> İşlenen Veriler</h4>
        <ul>
            <li>Yaş</li>
            <li>Boy</li>
            <li>Kilo</li>
            <li>Fiziksel aktivite düzeyi</li>
        </ul>
        <p class="mt-2">
            Bu veriler yalnızca hesaplama amacıyla kullanılır.
        </p>
    </div>

    <div class="policy-card">
        <h4><i class="bi bi-gear"></i> Kullanım Amaçları</h4>
        <ul>
            <li>BMH ve BKI hesaplamaları</li>
            <li>Kalori ve makro analizleri</li>
            <li>Diyet planlama desteği</li>
        </ul>
    </div>

    <div class="policy-card">
        <h4><i class="bi bi-database"></i> Veri Saklama</h4>
        <p>
            Girilen veriler kalıcı olarak saklanmaz. Sadece anlık hesaplama yapılır.
        </p>
    </div>

    <div class="policy-card">
        <h4><i class="bi bi-shield-check"></i> Güvenlik</h4>
        <p>
            Verilerin korunması için gerekli teknik önlemler alınmaktadır.
            Ancak internet ortamında %100 güvenlik garanti edilemez.
        </p>
    </div>

    <div class="policy-card">
        <h4><i class="bi bi-exclamation-triangle"></i> Tıbbi Uyarı</h4>
        <p class="highlight">
            Bu uygulama sadece hesaplama aracıdır. Tıbbi teşhis veya tedavi yerine geçmez.
        </p>
    </div>

    <div class="policy-card">
        <h4><i class="bi bi-envelope"></i> İletişim</h4>
        <p>
            Her türlü soru için:
            <br />
            <strong>gozdeaybeyy@gmail.com</strong>
        </p>
    </div>

</div>